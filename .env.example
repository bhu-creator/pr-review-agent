# ─────────────────────────────────────────────────────────────────────────────
# AI PR Review Agent — Local Environment Variables
# Copy this file to .env and fill in your values.
# When running in Azure Pipelines, these are set automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini API Key (free at https://aistudio.google.com/app/apikey) ──────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Azure DevOps — Organisation & Project ────────────────────────────────────
ADO_ORG_URL=https://dev.azure.com/YOUR_ORG_NAME
ADO_PROJECT=YOUR_PROJECT_NAME
ADO_REPO_NAME=YOUR_REPO_NAME

# ── Pull Request ID to review (for local testing) ────────────────────────────
ADO_PR_ID=1

# ── Azure DevOps Personal Access Token (PAT) ─────────────────────────────────
# Scopes needed: Code (Read), Pull Request Threads (Read & Write)
# Generate at: https://dev.azure.com/{org}/_usersSettings/tokens
SYSTEM_ACCESSTOKEN=your_ado_pat_here
